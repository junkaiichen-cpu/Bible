{
  "name": "bible-fighter",
  "version": "0.9.1",
  "description": "Bible Fighter · Windows playable 2P fighting game · Build 18 Moses combat",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run repair:source && electron .",
    "repair:source": "node scripts/repair-build-source.mjs",
    "validate": "npm run repair:source && node scripts/validate-build.mjs",
    "dist:win": "npm run validate && electron-builder --win portable",
    "dist": "npm run validate && electron-builder"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.junkaiichen.biblefighter",
    "productName": "Bible Fighter",
    "files": [
      "playtest.html",
      "style.css",
      "game7.js",
      "game8.js",
      "game9.js",
      "game10.js",
      "game11.js",
      "game12.js",
      "game13.js",
      "game14.js",
      "game15.js",
      "game8.css",
      "data/**/*",
      "electron/**/*"
    ],
    "directories": { "output": "dist" },
    "asar": true,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    }
  }
}
